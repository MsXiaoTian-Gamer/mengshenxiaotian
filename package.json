{
  "name": "mengshen-xiaotian-blog",
  "private": true,
  "version": "2.0.0",
  "description": "萌神小天博客 - React + TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:site": "node scripts/gen-site.mjs",
    "gen:posts": "node scripts/gen-posts.mjs",
    "prebuild": "npm run gen:site && npm run gen:posts",
    "build": "tsc -b && vite build && node scripts/gen-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11"
  }
}
